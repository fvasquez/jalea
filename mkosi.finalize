#!/bin/bash
# Runs once, after all packages are installed, outside the image chroot.
# $BUILDROOT is the image tree.
set -euo pipefail

etc="$BUILDROOT/etc"
factory="$BUILDROOT/usr/share/factory"

# 1. Nothing that identifies a particular machine may be in the factory tree.
rm -f "$etc"/ssh/ssh_host_*_key "$etc"/ssh/ssh_host_*_key.pub
rm -f "$etc"/machine-id "$etc"/hosts "$etc"/fstab "$etc"/crypttab
rm -f "$etc"/resolv.conf
ln -s ../run/systemd/resolve/stub-resolv.conf "$etc/resolv.conf"
rm -f "$etc"/.pwd.lock "$etc"/mtab
ln -s ../proc/self/mounts "$etc/mtab"

# 2. Users and groups. systemd-sysusers builds /etc/passwd and friends from
#    scratch on first boot, so every account a Debian package created in its
#    postinst would be lost. Turn them into sysusers.d entries instead, with
#    the same IDs, skipping accounts that a sysusers.d file already defines.
declare -A known
for f in "$BUILDROOT"/usr/lib/sysusers.d/*.conf; do
    [[ -f $f ]] || continue
    while read -r kind name _; do
        [[ $kind == u || $kind == g ]] && known["$kind:$name"]=1
    done < <(grep -E '^[ug] ' "$f" || true)
done
out="$BUILDROOT/usr/lib/sysusers.d/zz-jalea-factory.conf"
{
    echo "# Generated by mkosi.finalize from the accounts Debian packages created at image build time."
    while IFS=: read -r name _ gid _; do
        [[ $gid -lt 1000 && $name != root && $name != nogroup ]] || continue
        [[ -v known[g:$name] ]] && continue
        echo "g $name $gid"
    done < "$etc/group"
    while IFS=: read -r name _ uid gid gecos home shell; do
        [[ $uid -lt 1000 && $name != root && $name != nobody ]] || continue
        [[ -v known[u:$name] ]] && continue
        printf 'u %s %s:%s "%s" %s %s\n' "$name" "$uid" "$gid" "$gecos" "${home:--}" "${shell:--}"
    done < "$etc/passwd"
    while IFS=: read -r gname _ _ members; do
        [[ -n $members ]] || continue
        for m in ${members//,/ }; do echo "m $m $gname"; done
    done < "$etc/group"
} > "$out"

# 3. Unit enablement belongs to the image, not to /etc. Presets and Debian
#    postinsts leave the wants and alias symlinks under /etc/systemd; moved
#    to /usr/lib/systemd they count the moment the new /usr is mounted, so a
#    unit that a new image version enables starts on the first boot after an
#    update. Left in /etc they would only arrive with the factory merge,
#    after systemd has planned that boot: one boot too late. Masks (links to
#    /dev/null) stay in /etc, the only place they are honoured.
for scope in system user; do
    src="$etc/systemd/$scope"
    dst="$BUILDROOT/usr/lib/systemd/$scope"
    [[ -d $src ]] || continue
    while IFS= read -r -d '' link; do
        rel=${link#"$src"/}
        [[ $(readlink "$link") == /dev/null ]] && continue
        if [[ -e $dst/$rel || -L $dst/$rel ]]; then
            rm "$link"       # the package ships it already
            continue
        fi
        mkdir -p "$(dirname "$dst/$rel")"
        mv "$link" "$dst/$rel"
    done < <(find "$src" -type l -print0)
    find "$src" -mindepth 1 -type d -empty -delete
done

# 4. Jalea's own defaults live under /usr/share/jalea (see
#    /etc/profile.d/jalea-xdg.sh) and change with each update; a copy in
#    /etc would stay as it was on the device's first boot. Drop the Debian
#    samples that would shadow them.
rm -f "$etc"/xdg/foot/foot.ini
rmdir --ignore-fail-on-non-empty "$etc"/xdg/foot

# 5. Capture /etc as the factory defaults, minus the account databases, which
#    sysusers owns at runtime.
mkdir -p "$factory"
# --update=none: files already placed in the factory tree by mkosi.extra/
# (our own rauc, nix and sshd configuration) win over Debian's defaults.
cp --archive --no-target-directory --update=none "$etc" "$factory/etc"
rm -f "$factory"/etc/{passwd,group,shadow,gshadow,subuid,subgid}{,-}
ln -sr "$BUILDROOT/usr" "$factory/usr"

# 6. Keep the dpkg database with /usr (see tmpfiles.d/dpkg.conf).
mkdir -p "$factory/var/lib"
mv "$BUILDROOT/var/lib/dpkg" "$factory/var/lib/dpkg"

# 7. The runtime /etc must start empty so the C+ tmpfiles line populates it.
#    mkosi still needs a few things there to finish the build (os-release for
#    the UKI, the kernel command line); it reads them before the image is
#    packed, and the usr partition only takes /usr anyway.
:
