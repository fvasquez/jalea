[Unit]
Description=Install Jalea to a disk (interactive, on tty1)
After=systemd-udev-settle.service systemd-tmpfiles-setup.service
Wants=systemd-udev-settle.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/lib/jalea/installer
