[Unit]
Description=Install or upgrade the current Nix from nixpkgs in the system profile
Documentation=https://github.com/fvasquez/jalea
# Debian's Nix package is only the seed. With the network up, fetch the
# current release into /nix/var/nix/profiles/default, keep it current (at
# most weekly, see /usr/lib/jalea/nix-upgrade), and restart the daemon on it
# when it changes. Runs at boot and from nix-upgrade.timer.
After=network-online.target nix-daemon.service
Wants=network-online.target nix-daemon.service

[Service]
Type=oneshot
Environment=NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ExecStart=/usr/lib/jalea/nix-upgrade
Restart=on-failure
RestartSec=5min

[Install]
WantedBy=multi-user.target
