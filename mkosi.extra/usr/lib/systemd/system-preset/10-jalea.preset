enable systemd-networkd.service
enable systemd-networkd-wait-online.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable iwd.service
enable ssh.service
enable rauc.service
enable jalea-efi-entries.service
enable jalea-mark-good.service
enable jalea-snapper-setup.service
enable tailscaled.service
enable jalea-tailscale-operator.service
enable jalea-update.timer
enable nix-daemon.socket
enable nix-daemon.service
enable nix-upgrade.service
# Debian enables these from postinst; they have nothing to do here.
disable apt-daily.timer
disable apt-daily-upgrade.timer
disable e2scrub_all.timer
disable fstrim.timer
disable rauc-mark-good.service
# smartmontools is here for smartctl; smartd would poll the NVMe and try to
# mail root about it.
disable smartmontools.service
# systemd-pcrlock is experimental and fails without a Secure Boot database;
# the LUKS root is bound to PCR 7 directly instead.
disable systemd-pcrlock-*.service
disable systemd-pcrlock-*.timer
